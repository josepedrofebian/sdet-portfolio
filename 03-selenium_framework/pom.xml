<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- [Maven - Project] Versi model Maven -->
    <modelVersion>4.0.0</modelVersion>

    <!-- [Maven - Project] Identitas project -->
    <groupId>com.sdet</groupId>
    <artifactId>selenium-framework</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- [Maven - Project] Nama project -->
    <name>Selenium Automation Framework</name>

    <!-- [Maven - Java] Versi Java yang digunakan -->
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- [Maven - Encoding] Encoding source code -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- [Allure] Versi Allure Java -->
        <allure.version>2.35.3</allure.version>

        <!-- [AspectJ] Versi AspectJ untuk Allure -->
        <aspectj.version>1.9.25</aspectj.version>
    </properties>
    <!-- [Allure] Mengatur versi seluruh dependency Allure -->
    <dependencyManagement>
        <dependencies>

            <!-- [Allure] Bill of Materials untuk menjaga versi dependency tetap konsisten -->
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>
    <!-- [Maven - Dependencies] Library yang digunakan framework -->
    <dependencies>

        <!-- [Selenium] Web automation -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.49.0</version>
        </dependency>

        <!-- [TestNG] Test framework -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.11.0</version>
            <scope>test</scope>
        </dependency>

        <!-- [Allure] API untuk @Step dan fitur Allure -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-java-commons</artifactId>
        </dependency>

        <!-- [Allure] Integrasi Allure dengan TestNG -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- [AspectJ] Runtime untuk custom Aspect -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjrt</artifactId>
            <version>${aspectj.version}</version>
        </dependency>

        <!-- [Cucumber] Core engine untuk Step Definition -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>7.27.2</version>
            <scope>test</scope>
        </dependency>

        <!-- [Allure] Integrasi Allure dengan Cucumber 7 -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-cucumber7-jvm</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- [Cucumber] Integrasi Cucumber dengan TestNG -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <version>7.27.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- [Maven - Build] Konfigurasi proses build -->
    <build>

        <plugins>

            <!-- [Maven - Compiler] Compile Java source code -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>

                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>

            <!-- [Maven - Test] Menjalankan test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>

                <configuration>
                    <argLine>
                        -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                    </argLine>
                </configuration>

                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- [Allure] Generate dan menjalankan Allure Report -->
            <!-- [Allure] Generate Allure Report -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>3.0.2</version>

                <!-- [Allure] Menggunakan Allure 2 untuk generate report -->
                <configuration>
                    <reportVersion>2.39.0</reportVersion>
                </configuration>
            </plugin>
        </plugins>

    </build>

</project>