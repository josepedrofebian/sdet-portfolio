<?xml version="1.0" encoding="UTF-8"?>

<!-- [Maven] Root element untuk project Maven -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- [Maven] Versi model POM -->
    <modelVersion>4.0.0</modelVersion>

    <!-- [Maven] Identitas project -->
    <groupId>com.sdet</groupId>
    <artifactId>selenium-automation</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- [Maven] Versi Java yang digunakan -->
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <!-- [Maven] Dependency yang dibutuhkan project -->
    <dependencies>

        <!-- [Selenium] Library untuk mengontrol browser -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>4.35.0</version>
        </dependency>

    </dependencies>

</project>